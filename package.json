{
  "name": "koishi-plugin-nezha",
  "version": "1.0.3",
  "description": "哪吒监控 V2 面板查询：服务器状态/详情/服务监控/在线率/告警/历史指标，支持卡片出图与定时推送",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "templates",
    "assets"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node test/local.cjs",
    "prepack": "npm run build",
    "test:live": "node test/live.mjs"
  },
  "keywords": [
    "koishi",
    "plugin",
    "chatbot",
    "nezha",
    "monitor",
    "哪吒",
    "监控",
    "探针"
  ],
  "author": "叹号大帝",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thTag/koishi-plugin-nezha.git"
  },
  "homepage": "https://github.com/thTag/koishi-plugin-nezha#readme",
  "bugs": {
    "url": "https://github.com/thTag/koishi-plugin-nezha/issues"
  },
  "peerDependencies": {
    "koishi": "^4.17.0",
    "koishi-plugin-puppeteer": "^3.9.0"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-puppeteer": {
      "optional": true
    }
  },
  "koishi": {
    "description": {
      "zh": "查询哪吒监控面板：服务器状态/详情/服务监控/历史指标，可出卡片图",
      "en": "Query Nezha monitoring panel: server status, details, service monitors and metrics"
    },
    "service": {
      "optional": [
        "puppeteer"
      ]
    }
  },
  "devDependencies": {
    "@koishijs/plugin-mock": "^2.6.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ws": "^8.23.0"
  }
}
